{
  "name": "memoryling",
  "private": true,
  "version": "0.7.0",
  "description": "Your agent memories, alive.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "render:seed": "node scripts/render-procedural-seed.mjs",
    "tauri": "tauri",
    "build:windows": "tauri build --bundles nsis --ci",
    "test": "vitest run",
    "test:helpers": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Test-MemorylingHelpers.ps1",
    "check": "npm run test && npm run test:helpers && npm run build && cargo test --manifest-path src-tauri/Cargo.toml && cargo check --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.10",
    "@tauri-apps/cli": "^2"
  }
}
