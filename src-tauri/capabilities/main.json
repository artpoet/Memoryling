{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Detail-window access to approved Memoryling commands",
  "local": true,
  "webviews": ["main"],
  "permissions": [
    "allow-list-memory-sources",
    "allow-preview-memory-source",
    "allow-list-codex-threads",
    "allow-preview-codex-thread",
    "allow-cancel-memory-preview",
    "allow-get-memory-state",
    "allow-approve-memory-import",
    "allow-forget-memory-source",
    "allow-get-daily-scout-state",
    "allow-save-openai-api-key",
    "allow-test-openai-api-key",
    "allow-configure-daily-scout",
    "allow-disable-daily-scout",
    "allow-delete-openai-api-key",
    "allow-clear-daily-scout-history",
    "allow-reset-daily-scout",
    "allow-mark-daily-insight-read",
    "allow-open-daily-scout-link",
    "allow-reset-pet-onboarding",
    "allow-get-product-setup-state",
    "allow-complete-product-setup",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
