{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "pet",
  "description": "Content-minimized access for the floating pet surface",
  "local": true,
  "webviews": ["pet"],
  "permissions": [
    "allow-get-creature-render-state",
    "allow-show-pet-context-menu",
    "allow-get-pet-shell-state",
    "allow-dismiss-pet-onboarding",
    "allow-start-pet-dragging",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
