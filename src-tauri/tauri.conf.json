{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Memoryling",
  "version": "0.5.0",
  "identifier": "app.memoryling.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Memoryling",
        "url": "index.html?surface=detail",
        "width": 1180,
        "height": 780,
        "minWidth": 860,
        "minHeight": 640,
        "center": true,
        "visible": false,
        "focus": false
      },
      {
        "label": "pet",
        "title": "Memoryling Pet",
        "url": "index.html?surface=pet",
        "width": 360,
        "height": 430,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "focusable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Yupo Huang",
    "homepage": "https://github.com/artpoet/Memoryling",
    "copyright": "Copyright © 2026 Yupo Huang and Memoryling contributors",
    "shortDescription": "A local-first creature shaped by explainable agent memory.",
    "longDescription": "Memoryling is a bilingual local-first desktop creature whose supported changes retain inspectable source lineage.",
    "licenseFile": "../LICENSE",
    "resources": ["fixtures/codex-first-memory-v1.json"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["English", "TradChinese"]
      }
    }
  }
}
